# Copie para .env.local (ignorado pelo Git) se quiser mudar o padrão.
#
# VITE_DATA_SOURCE:
#   mock  -> dados de exemplo (padrão no npm run dev)
#   empty -> estados vazios
#   api   -> GET {VITE_API_URL}/api/site (padrão no build de produção)
#
# Em produção, defina como Variables do repositório no GitHub (Settings › Secrets and variables › Actions):
#   VITE_DATA_SOURCE=api
#   VITE_API_URL=https://<sua-api>.up.railway.app
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:8080

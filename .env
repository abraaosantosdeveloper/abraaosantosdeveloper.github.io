# De onde vêm os dados do site:
#   mock  -> dados de exemplo (src/data/mock.js), igual ao design
#   empty -> nada carregado: mostra os estados vazios
#   api   -> busca em VITE_API_URL/api/site (API Spring Boot)
VITE_DATA_SOURCE=mock

# URL da API (usada só com VITE_DATA_SOURCE=api). Sem barra no final.
VITE_API_URL=http://localhost:8080
